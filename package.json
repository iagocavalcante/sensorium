{
  "name": "sensorium",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "PORT=8787 ALLOWED_HOSTNAMES=localhost,127.0.0.1 tsx watch server/index.ts",
    "build": "tsc -b && vite build",
    "start": "node server-dist/server/index.js",
    "test:mcp": "node --experimental-strip-types scripts/test-mcp.ts",
    "test:expedition": "node --experimental-strip-types scripts/test-expedition.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/node": "^26.3.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  }
}
